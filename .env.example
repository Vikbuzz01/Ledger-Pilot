# Copy to .env for local development. Do not commit .env.
# Windows integrated authentication to the local SQL Server Express named instance.
# SQLAlchemy URL host uses the named instance separator directly.
DATABASE_URL=mssql+pyodbc://@.\SQLEXPRESS/LedgerPilot?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Generate a unique key with: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
DOCUMENT_STORAGE_ROOT=storage/uploads
MAX_DOCUMENT_UPLOAD_MB=20
