# Copy to .env for local development. Do not commit .env.
# This uses Windows integrated authentication and local TCP port 1433.
# Change localhost:1433 if your SQL Server instance uses another host or port.
APP_NAME=LedgerPilot
DEBUG=True

DB_SERVER=localhost\SQLEXPRESS
DB_NAME=LedgerPilot
DB_DRIVER=ODBC Driver 18 for SQL Server

DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes