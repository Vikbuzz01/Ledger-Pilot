# Copy to .env. Never commit populated credentials.
# Primary developer database. Keep SQL Server Express as the default.
DATABASE_MODE=sqlserver
DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/LedgerPilot?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=yes
# Portable judge/demo mode: set DATABASE_MODE=sqlite. Relative paths resolve from backend/.
SQLITE_DATABASE_PATH=storage/ledgerpilot-demo.sqlite3
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private uploads remain outside frontend/ and are ignored by Git.
DOCUMENT_STORAGE_ROOT=storage/uploads
MAX_DOCUMENT_UPLOAD_MB=20

# Optional. Deterministic reconciliation works without an AI provider.
# Set provider to openai_compatible and provide key/model/URL for AI investigations.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
